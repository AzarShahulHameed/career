generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  REVIEWER
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  SHORTLISTED
  INTERVIEW_SCHEDULED
  REJECTED
  OFFERED
  HIRED
}

enum ScreeningQuestionType {
  TEXT
  YES_NO
  MULTIPLE_CHOICE
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  passwordHash  String
  name          String
  role          Role          @default(REVIEWER)
  isActive      Boolean       @default(true)
  // true for invited accounts until they set their own password —
  // gates access at login until they do, so a temp password never
  // stays in effect as the real credential.
  mustChangePassword Boolean  @default(false)
  avatarUrl     String?
  avatarPublicId String?
  createdAt     DateTime      @default(now())
  applications  Application[] @relation("ReviewerApplications")
  statusEvents  StatusEvent[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]     @relation("AuditActor")
  pushSubscriptions PushSubscription[]
}

// One row per browser/device the user has enabled notifications on
// (Web Push API). A user can have several — e.g. desktop + phone.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

// One org can hire under multiple legal/brand entities (e.g. Catapult
// Auditing LLC vs NoblQ) — the logo is shared org-wide (Settings.logoUrl)
// but the NAME that appears on a job posting and in candidate emails is
// per-Company, since that's the entity actually hiring for that role.
model Company {
  id        String       @id @default(cuid())
  name      String
  createdAt DateTime     @default(now())
  jobs      JobPosting[]
}

enum Region {
  UAE
  INDIA
  BOTH
}

model JobPosting {
  id           String        @id @default(cuid())
  title        String
  department   String
  location     String
  employmentType String      @default("FULL_TIME")
  region       Region        @default(BOTH)
  description  String        @db.Text
  responsibilities String[]  @default([])
  requirements     String[]  @default([])
  niceToHave       String[]  @default([])
  salaryRange      String?
  deadline         DateTime?
  isFeatured       Boolean   @default(false)
  isActive     Boolean       @default(true)
  companyId    String?
  company      Company?      @relation(fields: [companyId], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  applications Application[]
  screeningQuestions ScreeningQuestion[]

  @@index([isActive])
  @@index([department])
  @@index([location])
  @@index([region])
}

// A per-job custom question asked at apply time (the "why so many resumes,
// let candidates self-screen up front" ask). `disqualifyingAnswer`, when
// set, is compared case-insensitively against the candidate's answer by the
// ATS engine — a match means an automatic fail regardless of resume score,
// e.g. "Are you authorized to work in the UAE?" with disqualifyingAnswer
// "No". Leave it blank for a question that's just informational.
model ScreeningQuestion {
  id                  String                @id @default(cuid())
  jobId               String
  job                 JobPosting            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  question            String
  type                ScreeningQuestionType @default(TEXT)
  options              String[]             @default([]) // used when type = MULTIPLE_CHOICE
  required            Boolean               @default(true)
  order               Int                   @default(0)
  disqualifyingAnswer String?
  // Set instead of deleted when an admin removes a question that already
  // has candidate answers on it — keeps those ScreeningAnswer rows (and
  // whatever ATS breakdown referenced them) intact, while hiding the
  // question from future applicants.
  archived            Boolean               @default(false)
  answers             ScreeningAnswer[]

  @@index([jobId])
}

model ScreeningAnswer {
  id            String            @id @default(cuid())
  applicationId String
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  questionId    String
  question      ScreeningQuestion @relation(fields: [questionId], references: [id])
  answer        String

  @@index([applicationId])
  @@index([questionId])
}

model Application {
  id              String            @id @default(cuid())
  jobId           String
  job             JobPosting        @relation(fields: [jobId], references: [id])
  candidateName   String
  email           String
  phone           String?
  nationality     String?
  currentLocation String?
  currentRole     String?
  yearsExperience String?
  linkedinUrl     String?
  portfolioUrl    String?
  resumeUrl       String
  resumePublicId  String
  coverLetterUrl  String?
  coverLetterPublicId String?
  coverLetterText String?           @db.Text
  source          String            // "linkedin" | "naukri" | "website"
  status          ApplicationStatus @default(SUBMITTED)
  reviewerId      String?
  reviewer        User?             @relation("ReviewerApplications", fields: [reviewerId], references: [id])
  statusHistory   StatusEvent[]
  screeningAnswers ScreeningAnswer[]
  // ATS auto-screening result — null until the engine has run (e.g. ATS
  // screening disabled, or resume text couldn't be extracted).
  atsScore         Int?     // 0-100
  atsBreakdown     Json?    // { matchedKeywords, missingKeywords, disqualifiedReason? }
  atsAutoRejected  Boolean  @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([jobId])
  @@index([status])
  @@index([email])
}

model StatusEvent {
  id            String            @id @default(cuid())
  applicationId String
  application   Application       @relation(fields: [applicationId], references: [id])
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  note          String?
  interviewDate     String?
  interviewTime     String?
  interviewLocation String?
  changedById   String
  changedBy     User              @relation(fields: [changedById], references: [id])
  emailSent     Boolean           @default(false)
  createdAt     DateTime          @default(now())

  @@index([applicationId])
}

// Singleton row — org-wide branding. Logo is shared across every Company
// entity; per-entity name lives on Company instead, since that's what
// varies between Catapult Auditing LLC, NoblQ, etc.
model Settings {
  id           String   @id @default("singleton")
  companyName  String   @default("Our Company") // fallback when a job has no Company assigned
  logoUrl      String?
  logoPublicId String?
  senderEmail  String?
  // ATS auto-screening — off by default so nothing auto-rejects until you
  // opt in and set a threshold you're comfortable with.
  atsEnabled       Boolean  @default(false)
  atsPassThreshold Int      @default(50) // 0-100, percentage of matched requirement keywords
  updatedAt    DateTime @updatedAt
}

// Admin-editable override per status. If no row exists for a status, the
// hardcoded default in status-templates.ts is used — so this table only
// needs to hold what's actually been customized, not all seven statuses.
model EmailTemplate {
  status    ApplicationStatus @id
  subject   String
  bodyHtml  String            @db.Text
  updatedAt DateTime          @updatedAt
}

// General-purpose audit trail — separate from StatusEvent (which already
// covers application status changes in full detail: from/to/note/reviewer).
// Covers everything else an admin can do: creating/editing/deleting job
// postings, managing team members, changing org settings. One row per
// action, human-readable description first — not a full diff/versioning
// system, just "who did what, when."
model AuditLog {
  id          String   @id @default(cuid())
  actorId     String
  actor       User     @relation("AuditActor", fields: [actorId], references: [id])
  action      String   // e.g. "job.created", "job.deleted", "user.deleted", "settings.updated"
  entityType  String   // e.g. "JobPosting", "User", "Settings"
  entityId    String?
  description String   // e.g. Deleted job posting "Associate" (12 applications removed)
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}
