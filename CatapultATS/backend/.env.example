DATABASE_URL="postgresql://user:password@host:5432/ats_portal?sslmode=require"
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_DAYS="7"
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
FRONTEND_URL="https://careers.yourcompany.com,https://cat-cons.com"
PORT=4000

RESEND_API_KEY="re_your_api_key"
EMAIL_FROM="careers@yourcompany.com"
COMPANY_NAME="Your Company"

# Optional — used by prisma/seed.ts. If omitted, a random password is
# generated and printed once at seed time (never stored in source).
ADMIN_EMAIL="admin@yourcompany.com"
ADMIN_PASSWORD=""
